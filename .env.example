# Puerto del servidor
PORT=3000

# --- Base de datos PostgreSQL ---
# Opción A (producción, Vercel + Neon): la cadena de conexión que da Neon.
# Si está definida, se ignoran los datos DB_* de abajo.
# DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Opción B (en la compu): PostgreSQL local
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=diverty_park

# Clave secreta para firmar los tokens JWT (usar una cadena larga y aleatoria en producción)
JWT_SECRETO=reemplazar_con_una_clave_secreta_larga

# URL del frontend (para configurar CORS en producción, ej: https://diverty-park.vercel.app)
FRONTEND_URL=http://localhost:3000

# --- Sólo en Vercel ---
# Token de Vercel Blob para guardar las fotos de las salas (Vercel lo crea solo al conectar un Blob store)
# BLOB_READ_WRITE_TOKEN=
# Clave para que sólo Vercel Cron pueda llamar a /api/cron/expirar
# CRON_SECRET=

# Ruta a pg_dump para las copias de seguridad (npm run backup), si no está en el PATH
# PG_DUMP="C:\Program Files\PostgreSQL\18\bin\pg_dump.exe"
